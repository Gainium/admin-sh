# Required
JWT_SECRET=changeme

# Redis (defaults assume the docker-sh compose network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Registry
DOCKER_REGISTRY_HOST=docker.gainium.io
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASS=

# Scope + paths
COMPOSE_PROJECT_NAME=gainium-sh
VERSIONS_ENV_PATH=/etc/gainium/.versions.env

# Host absolute path of the docker-sh project directory. Required only for
# self-upgrade (admin-sh recreating its own container). Leave empty to
# disable self-upgrade and report a clear error if attempted.
COMPOSE_DIR_HOST_PATH=
UPGRADE_HELPER_IMAGE=docker:27-cli

# HTTP
PORT=7507
CORS_ORIGIN=http://localhost:7500
