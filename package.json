{
  "name": "@gainium/admin-sh",
  "version": "1.4.0",
  "description": "Self-hosted Gainium admin API. Manages docker compose services, granular exchange enable/disable, and image upgrades for docker-sh deployments.",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dev": "ts-node -r dotenv/config --files --project tsconfig.json ./src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "tsc --noEmit --project tsconfig.json && eslint . --cache",
    "lint:fix": "eslint . --fix",
    "push": "git push origin main",
    "pull": "git pull origin main"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dockerode": "^4.0.4",
    "dotenv": "^17.2.0",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.32",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.1.0",
    "@types/semver": "^7.5.8",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
